# Mailschleuse configuration. Copy to .env and adjust what you need - every
# value below is optional and shown with its default.

# --- host ports -------------------------------------------------------------
MS_HTTP_PORT=8080
MS_SMTP_PORT=1025
MS_POP3_PORT=1110

# Container image and name
MS_IMAGE=ghcr.io/diesteinhose/mailschleuse:latest
MS_CONTAINER_NAME=mailschleuse

# --- identity ---------------------------------------------------------------
# Hostname the SMTP/POP3 greeting announces.
MS_HOSTNAME=mailschleuse.local
# Host shown in the UI's connection panel. Use the name your application will
# actually dial, e.g. the compose service name when both run in Docker.
MS_PUBLIC_HOST=localhost
# Mailboxes to create. The first is not special; add as many as you like.
MS_MAILBOXES=inbox,outbox

# --- SMTP (your application sends here) -------------------------------------
# Mailbox that receives everything submitted over SMTP.
MS_SMTP_MAILBOX=outbox
# disabled | optional | required
MS_SMTP_AUTH=optional
# Leave both empty to accept any credentials.
MS_SMTP_USERNAME=
MS_SMTP_PASSWORD=
# Let the SMTP login name choose the target mailbox (login "inbox" -> inbox).
MS_SMTP_MAILBOX_FROM_USERNAME=false
# Allow the X-Mailschleuse-Mailbox header to choose the target mailbox.
MS_SMTP_HEADER_ROUTING=true
# Prepend a Received header to every accepted message.
MS_SMTP_ADD_RECEIVED=true
MS_SMTP_MAX_RECIPIENTS=100

# --- POP3 (your application fetches here) -----------------------------------
MS_POP3_MAILBOX=inbox
# Leave both empty to accept any credentials.
MS_POP3_USERNAME=
MS_POP3_PASSWORD=
# Let the POP3 login name choose the mailbox (login "outbox" -> outbox).
MS_POP3_MAILBOX_FROM_USERNAME=false
# RFC 1939 exclusive access: refuse a second concurrent session per mailbox.
MS_POP3_EXCLUSIVE_LOCK=true

# --- web UI -----------------------------------------------------------------
# Optional HTTP basic auth for UI and API.
MS_WEB_USERNAME=
MS_WEB_PASSWORD=
# Serve the UI under a prefix, e.g. /mail behind a reverse proxy.
MS_WEB_BASE_PATH=/
# Disable every write operation in UI and API.
MS_WEB_READ_ONLY=false
# Allow browser API access from this origin, e.g. http://localhost:5173
MS_WEB_CORS_ORIGIN=

# --- storage ----------------------------------------------------------------
# Directory for persisted mail. Empty means memory only (gone on restart).
MS_DATA_DIR=/data
# Messages kept per mailbox; the oldest are dropped beyond this.
MS_MAX_MESSAGES=500
MS_MAX_MESSAGE_SIZE=25MB

# --- TLS --------------------------------------------------------------------
# off | auto | files. "auto" generates a self-signed certificate at start,
# which enables STARTTLS/STLS for clients that insist on encryption.
MS_TLS_MODE=auto
# MS_TLS_CERT_FILE=/certs/tls.crt
# MS_TLS_KEY_FILE=/certs/tls.key
# Optional implicit TLS listeners (empty = disabled).
# MS_SMTP_TLS_ADDR=:465
# MS_POP3_TLS_ADDR=:995

# --- misc -------------------------------------------------------------------
MS_IDLE_TIMEOUT=5m
MS_LOG_LEVEL=info
MS_LOG_FORMAT=text
